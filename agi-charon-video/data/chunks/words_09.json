, "text": "18.Continual learning system ko vakti kisaad update kare."}, {"start": 610.169, "end": 610.949, "text": "19.Verification layer."}, {"start": 611.169, "end": 612.389, "text": "20.Answer aur action ko chekk kare."}, {"start": 612.869, "end": 615.129, "text": "21.In module ki darmean information move kare ge."}, {"start": 615.329, "end": 617.789, "text": "22.Perception input ko transformer tak bhedh sakti hai."}, {"start": 618.049, "end": 620.089, "text": "23.Transformer planner ko goal sumja sakta hai."}, {"start": 620.089, "end": 622.049, "text": "पलन्र तूल को अक्षें दे सक्ता है"}, {"start": 622.049, "end": 624.249, "text": "तूल रँट वापस सिस्तम को मिल सक्ता है"}, {"start": 624.249, "end": 626.929, "text": "और मुढ्ल रँट का अंदाजा कमपयर कर सक्ता है"}, {"start": 626.929, "end": 629.369, "text": "वेम्रि प्रँडन्त एकस्पीडिन्त सब कर सकती है"}, {"start": 629.369, "end": 633.349, "text": "वरीफिकेशन लियर कह सकती है के आनसर एविदेन से मच करता है यह नहीं"}, {"start": 633.349, "end": 635.049, "text": "फिर सिस्तम नेक स्टेप चूस कर सकता है"}, {"start": 635.049, "end": 638.149, "text": "ये डायग्राम देखने में कमप्लीट लक सकता है"}, {"start": 638.149, "end": 642.369, "text": "लेकिन मोड्वूल्स को लिस्ट कर देना एजीआई बनने की गर्ठी नहीं"}, {"start": 642.369, "end": 644.049, "text": "कोडीनेशन मुषकिल हो सकती है"}, {"start": 644.049, "end": 645.469, "text": "मैमरी गलड दीते"}]}