": 250.715, "p": 0.93, "core": 1}, {"w": "मतलप", "start": 250.715, "end": 250.975, "p": 0.924, "core": 1}, {"w": "गोल", "start": 250.975, "end": 251.235, "p": 0.688, "core": 1}, {"w": "को", "start": 251.235, "end": 251.375, "p": 0.943, "core": 1}, {"w": "चोटी", "start": 251.375, "end": 251.675, "p": 0.66, "core": 1}, {"w": "स्थेपस", "start": 251.675, "end": 251.955, "p": 0.544, "core": 1}, {"w": "में", "start": 251.955, "end": 252.075, "p": 0.936, "core": 1}, {"w": "तोडना,", "start": 252.075, "end": 252.415, "p": 0.84, "core": 1}, {"w": "रीसोर्सिएज", "start": 252.415, "end": 253.155, "p": 0.397, "core": 1}, {"w": "चेक्करना,", "start": 253.155, "end": 253.595, "p": 0.642, "core": 1}, {"w": "आक्षिन", "start": 253.695, "end": 254.015, "p": 0.608, "core": 1}, {"w": "लीना,", "start": 254.015, "end": 254.295, "p": 0.841, "core": 1}, {"w": "रीजाल्ट", "start": 254.475, "end": 254.815, "p": 0.67, "core": 1}, {"w": "दीखना,", "start": 254.815, "end": 255.135, "p": 0.798, "core": 1}, {"w": "और", "start": 255.215, "end": 255.295, "p": 0.859, "core": 1}, {"w": "जरुरत", "start": 255.295, "end": 255.595, "p": 0.721, "core": 1}, {"w": "पर", "start": 255.595, "end": 255.795, "p": 0.801, "core": 1}, {"w": "प्लन", "start": 255.795, "end": 256.015, "p": 0.77, "core": 1}, {"w": "बदरना", "start": 256.015, "end": 256.395, "p": 0.806, "core": 1}, {"w": "है.", "start": 256.395, "end": 256.455, "p": 0.841, "core": 1}, {"w": "मिसाल", "start": 256.955, "end": 257.435, "p": 0.785, "core": 0}, {"w": "के", "start": 257.435, "end": 257.595, "p": 0.796, "core": 0}, {"w": "तोर...", "start": 257.595, "end": 257.735, "p": 0.612, "core": 0}], "segments": [{"start": 191.635, "end": 194.535, "text": "सवाल आलग है. लोंग्टाम मेमरी का मतलप सर्फ हर"}, {"start": 194.535, "end": 196.535, "text": "बात को एक बहुत लंबी लिस्ट मेर रभ देना नहीं."}, {"start": 196.755, "end": 199.175, "text": "सिस्टम को दिसाइट करना होगा कि क्या सेव करना है,"}, {"start": 199.435, "end": 201.935, "text": "किस दीटेल को इगनोर करना है, किस पुरानी मेमरी को"}, {"start": 201.935, "end": 203.895, "text": "अबडेट करना है, किस मेमरी को दुबारा"}, {"start": 203.895, "end": 206.295, "text": "retrieve करना है, और अगर दो मेमरीज में कुन्फलिक्त हो,"}, {"start": 206.495, "end": 209.295, "text": "तो किस पर भरोसा करना है. अच्टूड़ेंट का एकजाम्ठल समज है."}, {"start": 209.635, "end": 211.975, "text": "अच्टूड़ेंट के पास वोकिम मेमरी होती है, वो अगी एक"}, {"start": 211.975, "end": 214.295, "text": "मैट्स प्रबलम के स्टेप्स दिमाग में रकता है. उस के"}, {"start": 214.295, "end": 218.715, "text": "अपास पास्ट ठेक्सपीरियंज होता है, उसे याद होता है के टीचर ने पिछले टेस्ट में किस किस किसम का सवाल दिया था."}, {"start": 219.075, "end": 222.615, "text": "उसके पास शकिल मेमरी भी होती है, वो जानता है के फ्रक्ष्ट्शन्स कैसे सुल्फ करने है."}, {"start": 222.615, "end": 225.875, "text": "AGI sistem को भी शाए दिन मुख्तलिफ किसम की मेमरी की ज़ोरत हो."}, {"start": 226.235, "end": 228.235, "text": "वोकिं मेमरी करन्टास को समहाल सकती है."}, {"start": 228.535, "end": 231.615, "text": "लोंग्टोम मेमरी पुराने यवईंट्स, फैक्ट्स, और प्रफ्रिफ्रन्षेज रक सकती है."}, {"start": 231.935, "end": 234.235, "text": "शकिल मेमरी बताती है किसी काम को कैसे करना है."}, {"start": 234.235, "end": 236.995, "text": "लेकिन मेमरी अकेली अंटलगेंस क्रिएट नहीं करती."}, {"start": 237.315, "end": 238.935, "text": "अगर इंप्लोई के पास हाजारो फाट्यल्स हो,"}, {"start": 239.115, "end": 241.095, "text": "लेकिन वो सही फाट्यल सही वक्त पर दूँन ना सके,"}, {"start": 241.255, "end": 242.755, "text": "तो फाट्यल्स उसे समार्ट नहीं बनाएंगी."}, {"start": 242.755, "end": 245.955, "text": "मेमरी को रेट्रीव, अर्गनाईज, अब्टेट और वेरिफाई करना होगा."}, {"start": 246.455, "end": 247.975, "text": "यहां प्लानिँग का चालिएँ सामने आता है."}, {"start": 248.275, "end": 250.175, "text": "प्लानिँग का मतलप सरफ एक लिस्ट लिग देना नहीं."}, {"start": 250.275, "end": 252.415, "text": "प्लानिँग का मतलप गोल को चोटी स्थेपस में तोडना,"}, {"start": 252.415, "end": 256.455, "text": "रीसोर्सिएज चेक्करना, आक्षिन लीना, रीजाल्ट दीखना, और जरुरत पर प्लन बदरना है."}, {"start": 256.955, "end": 257.735, "text": "मिसाल के तोर..."}]}