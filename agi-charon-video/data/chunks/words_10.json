: 708.032, "end": 708.032, "p": 0.688, "core": 1}, {"w": "or", "start": 708.032, "end": 708.572, "p": 0.73, "core": 1}, {"w": "if", "start": 708.572, "end": 708.612, "p": 0.378, "core": 1}, {"w": "the", "start": 708.612, "end": 708.732, "p": 0.337, "core": 1}, {"w": "models", "start": 708.732, "end": 708.872, "p": 0.171, "core": 1}, {"w": "are", "start": 708.872, "end": 709.072, "p": 0.225, "core": 1}, {"w": "external", "start": 709.072, "end": 709.392, "p": 0.239, "core": 0}, {"w": "for", "start": 709.392, "end": 709.452, "p": 0.276, "core": 0}, {"w": "external", "start": 709.452, "end": 709.792, "p": 0.213, "core": 0}, {"w": "models.", "start": 709.792, "end": 709.912, "p": 0.111, "core": 0}], "segments": [{"start": 643.492, "end": 647.532, "text": "हो सकती है, memory गलत दीटेल स्वर कर सकती है, planner रों"}, {"start": 647.532, "end": 651.332, "text": "गोल फोलो कर सकता है, world model inaccurate prediction दे सकता है,"}, {"start": 651.772, "end": 655.812, "text": "tool misuse हो सकता है, continual learning अनसेथ अबडेट कर सकती है,"}, {"start": 656.272, "end": 660.572, "text": "system laboratory में अच्धाम कर सकता है, lakin unfamiliar real world में"}, {"start": 660.572, "end": 663.632, "text": "weak generalization दिखा सकता है. एक कमपनी में"}, {"start": 663.632, "end": 665.872, "text": "देपार्टमेंस होना और देपार्टमेंस का सहीं"}, {"start": 673.492, "end": 674.652, "text": "अजुद प्रोज्ट फेल हो सकता है."}, {"start": 675.032, "end": 677.332, "text": "अगी आगी अखिटेक्चर मे भी मोड्टूल्स के दर में"}, {"start": 677.332, "end": 679.872, "text": "क्लीर कमूनिकेशन, प्राईटीख, प्रमिश्यन्स"}, {"start": 679.872, "end": 681.652, "text": "अर फीटबाग जरूरी हो सकते हैं."}, {"start": 681.652, "end": 684.392, "text": "इसी लिए बिगर त्रान्स्फोमर को इगनोर नहीं किया जासकता."}, {"start": 684.392, "end": 688.012, "text": "बिगर मोडल में जीआदा पाटरन्स, जीआदा रेप्रिश्टेशन्स और जीआदा"}, {"start": 688.012, "end": 690.372, "text": "फलक्सबल रीजनिग आसकती है. लाज़र त्रीनिग से"}, {"start": 690.372, "end": 693.252, "text": "केपिपिलिटीज रोग सकती है. लेकिन बिगर एंजन के साद"}, {"start": 693.252, "end": 695.512, "text": "गाडी के बाखी सिस्तम्स अटमातिकली नहीं बन जाते."}, {"start": 695.512, "end": 700.392, "text": "memory management, long term planning, real world grounding, verification and safe learning"}, {"start": 700.392, "end": 701.452, "text": "and other engineering problems."}, {"start": 702.252, "end": 704.612, "text": "अब यी फाइनल अन्सर किसी के पास नहीं,"}, {"start": 704.612, "end": 708.032, "text": "researchers are exploring if there will be enough giant models for AGI"}, {"start": 708.032, "end": 709.912, "text": "or if the models are external for external models."}]}