ें ये आक्ष्चन करूं, तो मुमकिन है क्या रिजल्टा है"}, {"start": 351.386, "end": 353.326, "text": "वोल्ट मोडल गलत भी हो सकता है"}, {"start": 353.326, "end": 355.646, "text": "इसे यह रेल वल्ट चेकिंग जरूरी रहेगी."}, {"start": 356.246, "end": 358.446, "text": "तूल्स आईई सिस्टम की रीच को बड़ा सकते है."}, {"start": 358.766, "end": 360.706, "text": "ब्रूव्ट लेटिस्ट न्फोमेशन दून सकता है,"}, {"start": 361.006, "end": 362.526, "text": "काल्कौलेटर नम्बर्स चेक कर सकता है,"}, {"start": 362.886, "end": 364.846, "text": "कोट एक्छिकुष्टूल प्रोग्राम चला सकता है."}, {"start": 364.846, "end": 367.006, "text": "देटाबेस कम्पनी के लेकोट्स दे सकता है,"}, {"start": 367.326, "end": 368.886, "text": "क्यम्रा रूम का सींग दिखा सकता है,"}, {"start": 369.286, "end": 372.346, "text": "रोबाट के सेंसर, तेमठ्रच्यर, दिस्टन्स, और मुवम्म्ड बता सकते है."}, {"start": 372.866, "end": 375.706, "text": "इस पूरी प्रोसेस को एक लूप की तरह दिखा सकता है,"}, {"start": 375.706, "end": 378.766, "text": "तिंक, आक्त, अबजर्व, अबदेट."}, {"start": 379.286, "end": 382.646, "text": "निस्तम पहले सुचता है, फिर तूल या अवाविर में अक्षन लेता है,"}, {"start": 383.026, "end": 386.626, "text": "फिर रिजाल्ट अबजर्व तरता है, फिर अपनी नेक्स डिसिचन के लिए अबज़्ेट होता है."}, {"start": 386.626, "end": 387.806, "text": "अगर कालकूलेटर"}]}