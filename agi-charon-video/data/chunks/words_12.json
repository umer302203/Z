": 834.068, "p": 0.61, "core": 1}, {"w": "हो", "start": 834.068, "end": 834.228, "p": 0.868, "core": 1}, {"w": "सकते", "start": 834.228, "end": 834.488, "p": 0.896, "core": 1}, {"w": "है.", "start": 834.488, "end": 834.628, "p": 0.964, "core": 1}, {"w": "लिकिन", "start": 834.888, "end": 835.128, "p": 0.688, "core": 1}, {"w": "कम्ठीत", "start": 835.128, "end": 835.728, "p": 0.345, "core": 1}, {"w": "एगाईएगा", "start": 835.728, "end": 836.368, "p": 0.459, "core": 1}, {"w": "क्लीन", "start": 836.368, "end": 836.668, "p": 0.595, "core": 1}, {"w": "अभी", "start": 836.668, "end": 836.928, "p": 0.875, "core": 1}, {"w": "जल्दी", "start": 836.928, "end": 837.248, "p": 0.867, "core": 1}, {"w": "होगा.", "start": 837.248, "end": 837.508, "p": 0.941, "core": 1}], "segments": [{"start": 774.188, "end": 776.708, "text": "किस अरेट्टेक्छीर के अंदर रखना होगा."}, {"start": 777.088, "end": 779.088, "text": "हो सकता है, जवाब में रवकिग मेमरी,"}, {"start": 779.308, "end": 781.908, "text": "ल� Neden Memory, लांगटर मेमरी, प्लानिग, वोडल्ठ,"}, {"start": 782.248, "end": 787.088, "text": "यार काई उएा इड़ धीछा की आता रदवार।,"}, {"start": 791.628, "end": 794.368, "text": "दोगन्गर्ट्स, नहीं अगर चलीज की नाग।,"}, {"start": 794.368, "end": 797.748, "text": "AGI के लिए स्व्ट जीआदा टेक्स्ट, जीआदा परामेटर्स,"}, {"start": 797.948, "end": 800.128, "text": "या जीआदा फ्लूएण्ट आंसर्स शाएद ना हूं."}, {"start": 800.448, "end": 804.148, "text": "एक कमप्लीट सिस्टम को देखना, याद रखना, प्लान करना,"}, {"start": 804.148, "end": 806.328, "text": "act करना, result चेक करना"}, {"start": 806.328, "end": 808.008, "text": "और अपनी learning को सेझफली"}, {"start": 808.008, "end": 809.388, "text": "update करना भी हो सकता है."}, {"start": 809.828, "end": 811.988, "text": "अगर future में AGI देखलाप होती है,"}, {"start": 812.248, "end": 813.168, "text": "तो मुमकिन है वो एक"}, {"start": 813.168, "end": 814.408, "text": "single model से नहीं"}, {"start": 814.408, "end": 815.648, "text": "बलकी connected cognitive"}, {"start": 815.648, "end": 816.568, "text": "system से आई."}, {"start": 816.908, "end": 818.388, "text": "transformer उस सिस्तम का"}, {"start": 818.388, "end": 820.348, "text": "important reasoning कोर हो सकता है."}, {"start": 820.668, "end": 821.728, "text": "लेकिन उसके साथ memory,"}, {"start": 822.208, "end": 823.588, "text": "planning, world models,"}, {"start": 823.928, "end": 825.388, "text": "tools, continual learning"}, {"start": 825.388, "end": 826.908, "text": "और verification की layers"}, {"start": 828.188, "end": 831.868, "text": "अब तक ये मुद्यूल्दा रिलायबल तरीके से मिलके खाम नहीं करते,"}, {"start": 832.168, "end": 834.628, "text": "तब तक हमारे पास पावोफुल एए तो हो सकते है."}, {"start": 834.888, "end": 837.508, "text": "लिकिन कम्ठीत एगाईएगा क्लीन अभी जल्दी होगा."}]}