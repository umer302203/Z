: 446.594, "end": 447.414, "p": 0.669, "core": 1}, {"w": "दोक्तर", "start": 447.414, "end": 447.834, "p": 0.601, "core": 1}, {"w": "भी", "start": 447.834, "end": 447.974, "p": 0.91, "core": 1}, {"w": "हर", "start": 447.974, "end": 448.194, "p": 0.681, "core": 1}, {"w": "केस", "start": 448.194, "end": 448.434, "p": 0.679, "core": 1}, {"w": "में", "start": 448.434, "end": 448.634, "p": 0.902, "core": 1}, {"w": "फरुन", "start": 448.634, "end": 448.914, "p": 0.531, "core": 1}, {"w": "फाइनल", "start": 448.914, "end": 449.294, "p": 0.625, "core": 1}, {"w": "आनसर", "start": 449.294, "end": 449.594, "p": 0.611, "core": 1}, {"w": "नहीं", "start": 449.594, "end": 449.794, "p": 0.938, "core": 1}, {"w": "देता.", "start": 449.794, "end": 450.074, "p": 0.877, "core": 1}, {"w": "वो", "start": 450.454, "end": 450.574, "p": 0.799, "core": 1}, {"w": "तेस्त", "start": 450.574, "end": 450.914, "p": 0.744, "core": 1}, {"w": "मंगता", "start": 450.914, "end": 451.274, "p": 0.681, "core": 1}, {"w": "है,", "start": 451.274, "end": 451.494, "p": 0.955, "core": 0}, {"w": "सेकंडो", "start": 451.654, "end": 452.054, "p": 0.608, "core": 0}, {"w": "प्रुएश्वाद.", "start": 452.054, "end": 452.114, "p": 0.354, "core": 0}], "segments": [{"start": 385.834, "end": 389.814, "text": "अब देट होता है. अगर काल्कौलेटर कर लिएट अज्टर से मैच ना करे,"}, {"start": 389.974, "end": 391.994, "text": "तो सिस्तम अपना अज्टर दुबारा चेक कर सकता है."}, {"start": 392.574, "end": 394.854, "text": "लेकिन तूल यूज भी अटोमातिक स्लूशन नहीं."}, {"start": 395.174, "end": 398.554, "text": "आई गलत वेप साथ चूस कर सकती है, गलत डेटा बेज फिल पर सकती है,"}, {"start": 398.554, "end": 400.474, "text": "कोट को गलत इंपूट दे सकती है."}, {"start": 400.854, "end": 404.174, "text": "तूल का रिजल्त सही हो, लेकिन सिस्तम उसका मतलब गलत समज सकता है."}, {"start": 404.694, "end": 408.054, "text": "इसलिये तूल यॐस के सात वेरिफिकेशन और पमिशन्स भी पहुट्टवन्त हो सकती है."}, {"start": 408.954, "end": 411.214, "text": "हलुसिनेशन का मस्ला इसी जगा पहुटवन्त हो जाता है."}, {"start": 411.214, "end": 414.374, "text": "कभी A.I. बहुत कोई अथा जबा बना देती है,"}, {"start": 414.594, "end": 417.314, "text": "जो सुन्ने में ठीक लकता है, लेकिन ख़ट्छूली गलत होता है."}, {"start": 417.794, "end": 420.394, "text": "वो प्वेख शाटेशन दे सकती है, रों देट बता सकती है,"}, {"start": 420.814, "end": 423.254, "text": "अजी परसन का नाम बना सकती है, जो एकसिस्त ही नहीं करता."}, {"start": 423.254, "end": 425.694, "text": "AI जान्बुचकर जूट नहीं बोल रही होती."}, {"start": 426.154, "end": 428.074, "text": "वो लाएक्ली वोर्ट्स जनरेट कर रही होती हैं."}, {"start": 428.294, "end": 430.594, "text": "फ्लुएंट आंसर वेरिफाइ आंसर की गारेंटी नहीं."}, {"start": 430.954, "end": 434.334, "text": "सेल्फ मूनिटरिंग का मतलब अपनी अंसर्टेंटी को नोटेस करना."}, {"start": 434.334, "end": 438.254, "text": "सिस्तम को कभी کہना जाहीए, मेरे पास एन्फ एवविदेन्स नहीं."}, {"start": 438.254, "end": 441.414, "text": "या इस रिज़्ाल्ट को अच्टरनल सोर्से वेरिफाई करना होगा."}, {"start": 441.854, "end": 443.514, "text": "या मुझे हुमन हैल्प जाहीए."}, {"start": 443.914, "end": 446.594, "text": "ये वीकनेस नहीं ये सेप बहेविर हो सकता है."}, {"start": 446.594, "end": 450.074, "text": "एक दोक्तर भी हर केस में फरुन फाइनल आनसर नहीं देता."}, {"start": 450.454, "end": 452.114, "text": "वो तेस्त मंगता है, सेकंडो प्रुएश्वाद."}]}